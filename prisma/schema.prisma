// =============================================================================
//  ALSERLA BINGO — Prisma Schema
//  Motor Determinístico Stateless + Pagos Híbridos + Roles + Retiros
// =============================================================================
//
//  ECONOMÍA: todos los montos (balance, cardPrice, premios, recargas, retiros)
//  se almacenan en CENTAVOS de USD (Int). $5.00 = 500. El frontend formatea
//  con formatUSD(cents) => "$5.00 USD".
//
//  PORTABILIDAD: funciona en SQLite (dev) y PostgreSQL/Neon (prod):
//    - `Json` -> `jsonb` en Neon (ballSequence, grid, accountData, raw)
//    - "enum-like" String restringidos en la capa de app con uniones TS.
//
//  UPGRADE A NEON: `provider = "postgresql"` + DATABASE_URL Neon + `prisma db push`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  USERS & ROLES
//  balance en centavos USD. Bono de bienvenida $5.00 = 500 al registrarse.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String?  @unique // opcional: adultos mayores pueden registrarse solo con teléfono
  phone        String?  @unique // número de WhatsApp (login alternativo)
  username     String?  @unique // usuario corto (login alternativo)
  name         String
  passwordHash String? // null => cuenta solo magic-link (futuro)
  role         String   @default("PLAYER") // PLAYER | HOST | ADMIN
  balance      Int      @default(0) // centavos USD (Bingo 75)
  // ── La Tómbola Caliente (economía de PUNTOS gratis, aislada del USD) ──
  points          Int      @default(1000) // puntos gratuitos iniciales
  lastDailyPointsAt DateTime? // reclamo de bonus +300 cada 12h
  referralCode    String?  @unique // código de referido para invitar amigos
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostedRooms       Room[]
  participations    RoomParticipant[]
  tickets           Ticket[]
  purchases         Purchase[]
  claims            Claim[]
  payments          PaymentTransaction[]
  transferRequests  TransferRequest[]    @relation("TransferRequestOwner")
  reviewedTransfers TransferRequest[]    @relation("TransferRequestReviewer")
  payouts           PrizePayout[]        @relation("PayoutOwner")
  reviewedPayouts   PrizePayout[]        @relation("PayoutReviewer")
  ledgerEntries     LedgerEntry[]
  tombolaBets       HotTombolaBet[]      // La Tómbola Caliente

  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────────
//  ROOM — Motor Determinístico Stateless (CERO timers en RAM) + Auto-detección
//
//  revealedCount = floor((effectiveNow - startedAt - pausedElapsedMs) / (intervalSec*1000))
//  effectiveNow = pausedAt ?? endedAt ?? serverNow
//
//  AUTO-DETECCIÓN: cada vez que revealedCount aumenta, evaluateRoomWins()
//  revisa todos los cartones activos. Si uno completa Línea (y es la 1ra de
//  la sala) => pausa automática. Si completa Bingo => fin automático.
//  lastEvalDrawIndex evita re-evaluar el mismo instante.
//
//  VISIBILIDAD: isPublic=true => visible en el lobby (saldo > 0). isPublic=false
//  => solo accesible vía enlace /invite/[inviteToken].
// ─────────────────────────────────────────────────────────────────────────────
model Room {
  id       String @id @default(cuid())
  token    String @unique // código corto de 6 chars (compartible)
  status   String @default("WAITING") // WAITING | RUNNING | PAUSED | ENDED
  gameType String @default("75")
  hostId   String
  host     User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // ── Visibilidad / invitación ───────────────────────────────────────────
  isPublic    Boolean @default(true) // pública (lobby) o privada (solo invite)
  inviteToken String  @unique @default(cuid()) // enlace único /invite/[inviteToken]

  // ── Reloj determinístico ───────────────────────────────────────────────
  ballSequence    Json? // number[] permutación [1..75] (source of truth)
  startedAt       DateTime? // inicio del reloj de sorteo
  pausedAt        DateTime? // != null => reloj congelado (auto-pausa por Línea)
  pausedElapsedMs Int      @default(0) // ms pausados acumulados
  intervalSec     Int      @default(5) // segundos entre bolillas
  lastEvalDrawIndex Int    @default(0) // último drawIndex evaluado por auto-detección

  // ── Economía configurable por sala (centavos USD) ───────────────────────
  cardPrice    Int    @default(100) // mínimo $1.00 = 100
  prizeLine    Int    @default(500) // $5.00
  prizeCorners Int    @default(400) // $4.00
  prizeBingo   Int    @default(2000) // $20.00
  currency     String @default("USD")

  // ── Ciclo de vida ──────────────────────────────────────────────────────
  endedAt          DateTime?
  scheduledStartAt DateTime? // auto-inicio opcional (cron externo)
  currentRound     Int      @default(1) // soporta re-compra entre rondas
  meta             Json? // calendario, notas, config personalizada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants RoomParticipant[]
  tickets      Ticket[]
  purchases    Purchase[]
  draws        Draw[]
  claims       Claim[]

  @@index([status])
  @@index([hostId])
  @@index([isPublic])
}

// ─────────────────────────────────────────────────────────────────────────────
//  ROOM PARTICIPANTS — quién está en cada sala (1 usuario x 1 sala)
// ─────────────────────────────────────────────────────────────────────────────
model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  PURCHASE — cabecera agregada de una transacción buyCards (centavos USD)
// ─────────────────────────────────────────────────────────────────────────────
model Purchase {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  quantity  Int
  unitPrice Int // centavos USD
  totalCost Int // centavos USD
  round     Int      @default(1)
  createdAt DateTime @default(now())

  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([roomId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  TICKET — cartón 5x5 (B:1-15, I:16-30, N:31-45, G:46-60, O:61-75)
//  grid = (number|null)[][] con grid[2][2] = null (centro libre).
//
//  MULTIGANANCIA: un cartón puede ganar Línea, Esquinas y Bingo en la misma
//  partida. Las victorias de Línea/Esquinas se registran via Claims (valid=true)
//  SIN cambiar el status del cartón — sigue ACTIVE y puede ganar Bingo.
//  status solo cambia a WON_BINGO (cartón lleno, terminal) o CANCELLED.
// ─────────────────────────────────────────────────────────────────────────────
model Ticket {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  purchaseId String?
  grid       Json // (number|null)[][] 5x5
  status     String   @default("ACTIVE") // ACTIVE | WON_BINGO | CANCELLED
  createdAt  DateTime @default(now())

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  claims   Claim[]

  @@index([roomId])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  DRAW — historial/auditoría append-only de bolillas reveladas.
// ─────────────────────────────────────────────────────────────────────────────
model Draw {
  id         String   @id @default(cuid())
  roomId     String
  number     Int
  order      Int // índice 1-based de revelado
  revealedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, order])
  @@unique([roomId, number])
  @@index([roomId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  CLAIM — victoria de premio (LINE | CORNERS | BINGO), auto o manual.
//  Un mismo ticket puede tener varios Claims válidos (Línea + Esquinas + Bingo).
//  drawIndex = revealedCount al ganar (co-ganadores comparten drawIndex).
//  prizeAwarded audita cuánto se acreditó (centavos USD).
// ─────────────────────────────────────────────────────────────────────────────
model Claim {
  id           String   @id @default(cuid())
  roomId       String
  userId       String
  ticketId     String?
  type         String // LINE | CORNERS | BINGO
  valid        Boolean  @default(false)
  drawIndex    Int // revealedCount en el instante del claim
  prizeAwarded Int      @default(0) // centavos USD acreditados (0 si inválido)
  reason       String?
  createdAt    DateTime @default(now())

  room   Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  payout PrizePayout? // retiro asociado a este premio (opcional)

  @@index([roomId, type, valid])
  @@index([userId])
  @@index([ticketId, type])
}

// ─────────────────────────────────────────────────────────────────────────────
//  PAYMENT TRANSACTION — ledger idempotente de recargas (centavos USD).
// ─────────────────────────────────────────────────────────────────────────────
model PaymentTransaction {
  id          String    @id @default(cuid())
  userId      String
  provider    String // MERCADOPAGO | MANUAL_TRANSFER
  externalId  String? // MP payment id | referencia de transferencia
  amount      Int // centavos USD
  status      String    @default("PENDING") // PENDING|APPROVED|REJECTED|FAILED
  raw         Json? // payload del webhook / metadata
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transferRequest TransferRequest?

  @@unique([provider, externalId])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  TRANSFER REQUEST — recarga internacional manual pendiente (centavos USD)
// ─────────────────────────────────────────────────────────────────────────────
model TransferRequest {
  id              String    @id @default(cuid())
  userId          String
  amount          Int // centavos USD solicitados
  paymentMethod   String // "Bank Transfer"|"Wise"|"PIX"|"Zelle"|...
  country         String?
  referenceNumber String
  note            String?
  status          String    @default("PENDING") // PENDING|APPROVED|REJECTED
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  user                 User                @relation("TransferRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer             User?               @relation("TransferRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  payment              PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  paymentTransactionId String?             @unique

  @@index([status])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  PRIZE PAYOUT — solicitud de cobro de premio (retiro de ganancias).
//  Se crea automáticamente al ganar (modal de cobro) o a pedido del jugador.
//  El admin marca PAID con comprobante/ID de transacción.
//  amount en centavos USD. accountData (Json) guarda los datos según método.
// ─────────────────────────────────────────────────────────────────────────────
model PrizePayout {
  id          String    @id @default(cuid())
  userId      String
  roomId      String?
  claimId     String? @unique // victoria que lo originó (opcional, 1:1)
  amount      Int // centavos USD a retirar
  status      String    @default("PENDING") // PENDING | PAID
  country     String // "AR" | "INTERNACIONAL"
  method      String // ALIAS|CBU|USDT|BINANCE|PAYPAL|ZELLE
  accountData Json // {titular, alias, banco} | {wallet, network, email} ...
  notes       String?
  adminNote   String? // comprobante / ID de transcripción adjunto por admin
  paidById    String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  user    User   @relation("PayoutOwner", fields: [userId], references: [id], onDelete: Cascade)
  paidBy  User?  @relation("PayoutReviewer", fields: [paidById], references: [id], onDelete: SetNull)
  claim   Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  LEDGER ENTRY — auditoría append-only de TODA mutación de balance (centavos).
//  amount con signo: negativo débito, positivo crédito. balanceAfter snapshot.
// ─────────────────────────────────────────────────────────────────────────────
model LedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  type          String // PURCHASE|PRIZE|RECHARGE|PAYOUT|REFUND|ADMIN_ADJUST
  amount        Int // signado, centavos USD
  balanceAfter  Int // snapshot post-movimiento
  roomId        String?
  referenceType String? // "Purchase"|"Claim"|"PaymentTransaction"|"PrizePayout"
  referenceId   String?
  description   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([roomId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  LA TÓMBOLA CALIENTE — juego gratuito de puntos (aislado del Bingo 75/USD).
//  Motor determinístico stateless: bolillas reveladas por timestamp.
// =============================================================================

//  Ronda de La Tómbola. Provably Fair (serverSeed + seedHash SHA-256).
//  ballsSequence = bolillas precalculadas: doradas (+0.2x, x2...) y la bomba.
model HotTombolaRound {
  id            String    @id @default(cuid())
  serverSeed    String // seed secreta (se revela al final para verificación)
  seedHash      String // sha256(serverSeed) — pública desde el inicio
  status        String    @default("betting") // betting | running | crashed
  ballsSequence Json // [{type:"mult"|"double"|"bomb", label, add?, mult?}, ...]
  bettingEndsAt DateTime // fin de fase de apuestas (6s) = inicio fase running
  startedAt     DateTime? // = bettingEndsAt (para calcular ballIndex)
  crashedAt     DateTime? // momento en que salió la bomba
  createdAt     DateTime  @default(now())

  bets HotTombolaBet[]

  @@index([status])
  @@index([createdAt])
}

//  Apuesta de un jugador en una ronda de La Tómbola.
//  pointsWagered/pointsWon en PUNTOS (no USD). cashedOutAtBall = bolilla al retirar.
model HotTombolaBet {
  id               String   @id @default(cuid())
  roundId          String
  userId           String
  pointsWagered    Int
  cashedOutAtBall  Int? // ballIndex en el que retiró
  cashoutMultiplier Float? // multiplicador al retirar
  pointsWon        Int      @default(0) // puntos ganados (0 si busted)
  status           String   @default("active") // active | cashed_out | busted
  createdAt        DateTime @default(now())

  round HotTombolaRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([userId])
}
