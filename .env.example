# =============================================================================
#  ALSERLA BINGO — Variables de Entorno (.env.example)
#  Copia a .env y completa los valores. Nunca commitear .env real.
#
#  ECONOMÍA: todos los montos están en CENTAVOS de USD (Int). $5.00 = 500.
#  El frontend formatea con formatUSD(cents) => "$5.00 USD".
# =============================================================================

# ── BASE DE DATOS ───────────────────────────────────────────────────────────
# Local dev (SQLite — funciona sin instalar nada):
DATABASE_URL="file:./db/custom.db"

# Producción en Neon (PostgreSQL serverless) — descomenta y usa en Vercel:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15&pool_timeout=15"
# Neon recomienda el string "-pooler" para apps serverless (connection pooling).
# El schema Prisma es portable: con `provider = "postgresql"` y este URL,
# `npx prisma db push` crea todas las tablas en Neon automáticamente.

# ── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En Vercel: NEXT_PUBLIC_APP_URL="https://tu-dominio.vercel.app"

# ── AUTENTICACIÓN (JWT en cookie HTTP-only) ─────────────────────────────────
# Genera con: openssl rand -base64 48
AUTH_JWT_SECRET="cambia-esto-por-una-clave-secreta-larga-y-aleatoria-de-64-bytes-minimo"
AUTH_JWT_ISSUER="alserla-bingo"
AUTH_COOKIE_NAME="alserla_session"
# Duración de la sesión en segundos (7 días por defecto)
AUTH_SESSION_TTL_SEC="604800"

# ── MOTOR DE JUEGO (constantes por defecto en CENTAVOS USD, overrideable por sala) ──
DRAW_INTERVAL_SEC="5"      # segundos entre bolillas
INITIAL_CREDITS="500"      # bono de bienvenida al registrarse = $5.00 USD (500 centavos)
CARD_PRICE="100"           # precio por cartón por defecto = $1.00 USD (mínimo obligatorio)
PRIZE_LINE="500"           # premio Línea por defecto = $5.00 USD
PRIZE_CORNERS="400"        # premio Cuatro Esquinas por defecto = $4.00 USD
PRIZE_BINGO="2000"         # premio Bingo por defecto = $20.00 USD
DEFAULT_CURRENCY="USD"     # la moneda base de toda la plataforma es USD

# ── MERCADOPAGO (Checkout Pro + Webhook) ────────────────────────────────────
# Credenciales de la app en https://www.mercadopago.com/developers/
# Las preferencias se crean en USD (unit_price = centavos/100).
# El webhook convierte transaction_amount (dólares) a centavos al acreditar.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Webhook secret para validar autenticidad (configurado en el panel de MP):
MERCADOPAGO_WEBHOOK_SECRET=""
# URL del webhook pública (Vercel): https://tu-dominio/api/webhooks/mercadopago
# En local usa ngrok: NEXT_PUBLIC_APP_URL debe apuntar al túnel para que MP
# pueda alcanzar el webhook.

# ── ADMIN BOOTSTRAP ─────────────────────────────────────────────────────────
# Email del primer admin (se promueve a rol ADMIN al registrarse con este email).
# Solo el ADMIN puede crear salas y gestionar transferencias/retiros.
ADMIN_BOOTSTRAP_EMAIL="admin@bingo.local"
