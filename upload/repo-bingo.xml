import { Request } from 'express';
import { RoomsService } from './rooms.service';
import { CreateRoomDto, JoinRoomDto, BuyCardsDto, StartRoomDto, ClaimDto } from './dto';
import { GameGateway } from '../gateway/game.gateway';

@Controller('rooms')
export class RoomsController {
  constructor(
    private readonly roomsService: RoomsService,
    private readonly gateway: GameGateway,
  ) {}

  @Post()
  async create(@Body() dto: CreateRoomDto) {
    const appUrl = process.env.APP_PUBLIC_URL || 'http://localhost:3000';
    return this.roomsService.createRoom(dto, appUrl);
  }

  @Post('join')
  async join(@Body() dto: JoinRoomDto) {
    return this.roomsService.joinRoom(dto);
  }

  @Post(':roomId/buy')
  async buy(@Param('roomId') roomId: string, @Body() dto: BuyCardsDto) {
    // La verificación de “compras cerradas” se hace dentro del service (status !== 'waiting')
    const res = await this.roomsService.buyCards(roomId, dto);
    const state = await this.roomsService.getPublicState(roomId);
    this.gateway.broadcastState(roomId, state);
    return res;
  }

  @Post(':roomId/start')
  async start(@Param('roomId') roomId: string, @Body() dto: StartRoomDto) {
    const res = await this.roomsService.startRoom(roomId, dto);
    const state = await this.roomsService.getPublicState(roomId);
    this.gateway.broadcastRoomStatus(roomId, { status: 'running', startedAt: new Date() });
    this.gateway.broadcastState(roomId, state);
    return res;
  }

  // ✅ Estado REST incluye participants/purchases/claims para el panel del host y los players
  @Get(':roomId/state')
  async state(@Param('roomId') roomId: string) {
    return this.roomsService.getPublicState(roomId);
  }

  @Post(':roomId/claim')
  async claim(@Param('roomId') roomId: string, @Body() dto: ClaimDto) {
    const result = await this.roomsService.claim(roomId, dto);
    const state = await this.roomsService.getPublicState(roomId);
    this.gateway.broadcastState(roomId, state);
    return result;
  }

  @Post(':roomId/draws/next')
  async drawNext(@Param('roomId') roomId: string, @Req() req: Request) {
    const hostId = (req as any)?.user?.id ?? (req as any)?.auth?.userId ?? undefined;
    const { number, order } = await this.roomsService.drawNext(roomId, hostId);
    return { number, order };
  }

  // ✅ Reanudar auto-sorteo tras LÍNEA
  @Post(':roomId/resume')
  async resume(@Param('roomId') roomId: string, @Body() dto: StartRoomDto) {
    const res = await this.roomsService.resumeRoom(roomId, dto);
    const state = await this.roomsService.getPublicState(roomId);
    this.gateway.broadcastRoomStatus(roomId, { status: 'running' });
    this.gateway.broadcastState(roomId, state);
    return res;
  }

  // ====== ENDPOINTS HOST-ONLY: RESET & SCHEDULE ======

  @Post(':roomId/reset')
  async reset(@Param('roomId') roomId: string, @Body() body: { userId: string }) {
    const res = await this.roomsService.resetRoom(roomId, body.userId);
    const state = await this.roomsService.getPublicState(roomId);
    this.gateway.broadcastRoomReset(roomId);
    this.gateway.broadcastState(roomId, state);
    return res;
  }

  @Post(':roomId/schedule')
  async schedule(
    @Param('roomId') roomId: string,
    @Body() body: { userId: string; startAt: string } // ISO string
  ) {
    const res = await this.roomsService.scheduleRoom(roomId, body.userId, body.startAt);
    return res;
  }

  @Post(':roomId/schedule/cancel')
  async cancelSchedule(@Param('roomId') roomId: string, @Body() body: { userId: string }) {
    const res = await this.roomsService.cancelSchedule(roomId, body.userId);
    return res;
  }
}
</file>

