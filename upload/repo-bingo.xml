<file path="repair_bingo.ps1">
# ===========================
# repair_bingo.ps1  (Windows PowerShell)
# Repara/crea DB 'bingo' + esquema completo de forma idempotente.
# ===========================
$ErrorActionPreference = 'Stop'

# --- Config ---
$PGHOST       = '127.0.0.1'
$PGPORT       = 5432
$SUPER_USER   = 'postgres'
$SUPER_PASS   = 'postgres'
$APP_USER     = 'bingo'
$APP_PASS     = 'bingo'
$DBNAME       = 'bingo'

Write-Host "[0] psql => " ((Get-Command psql).Path) -ForegroundColor Cyan

function Run-PSQL {
  param(
    [string]$User,
    [string]$Pass,
    [string]$Db,
    [string]$Sql,
    [switch]$Quiet
  )
  $prev = $env:PGPASSWORD
  try {
    $env:PGPASSWORD = $Pass
    # -X y --no-psqlrc para evitar que psqlrc/meta rompa la salida
    $args = @('-h', $PGHOST, '-p', $PGPORT, '-U', $User, '-d', $Db, '-X', '--no-psqlrc', '-v', 'ON_ERROR_STOP=1', '-c', $Sql)
    if (-not $Quiet) { Write-Host ("psql " + ($args -join ' ')) -ForegroundColor DarkGray }
    & psql @args
    if ($LASTEXITCODE -ne 0) { throw "psql exitcode $LASTEXITCODE" }
  } finally {
    $env:PGPASSWORD = $prev
  }
}

function Run-PSQL-Query {
  param(
    [string]$User,
    [string]$Pass,
    [string]$Db,
    [string]$Sql
  )
  $prev = $env:PGPASSWORD
  try {
    $env:PGPASSWORD = $Pass
    # Usar -tAc para “solo valores”, y normalizar SIEMPRE la salida
    $args = @('-h', $PGHOST, '-p', $PGPORT, '-U', $User, '-d', $Db, '-X', '--no-psqlrc', '-tAc', $Sql)
    $raw = & psql @args 2>$null
    if ($LASTEXITCODE -ne 0) { throw "psql exitcode $LASTEXITCODE" }
    # $raw puede ser $null o array; normalizamos a string
    $text = ($raw | Out-String)
    if ($null -eq $text) { return "" }
    return $text.Trim()
  } finally {
    $env:PGPASSWORD = $prev
  }
}

# 1) Rol APP
Write-Host "`n[1] Rol $APP_USER ..." -ForegroundColor Cyan
$role = Run-PSQL-Query -User $SUPER_USER -Pass $SUPER_PASS -Db 'postgres' -Sql "SELECT 1 FROM pg_roles WHERE rolname='$APP_USER';"
if ([string]::IsNullOrWhiteSpace($role)) {
  Write-Host " - creando rol $APP_USER" -ForegroundColor Green
  Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db 'postgres' -Sql "CREATE ROLE $APP_USER LOGIN PASSWORD '$APP_PASS';" -Quiet
} else {
  Write-Host " - existe, actualizando password" -ForegroundColor Green
  Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db 'postgres' -Sql "ALTER ROLE $APP_USER WITH LOGIN PASSWORD '$APP_PASS';" -Quiet
}

# 2) Base de datos
Write-Host "`n[2] Base $DBNAME ..." -ForegroundColor Cyan
$db = Run-PSQL-Query -User $SUPER_USER -Pass $SUPER_PASS -Db 'postgres' -Sql "SELECT 1 FROM pg_database WHERE datname='$DBNAME';"
if ([string]::IsNullOrWhiteSpace($db)) {
  Write-Host " - creando DB $DBNAME (OWNER $APP_USER)" -ForegroundColor Green
  Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db 'postgres' -Sql "CREATE DATABASE $DBNAME OWNER $APP_USER TEMPLATE template0 ENCODING 'UTF8';" -Quiet
} else {
  Write-Host " - ya existe" -ForegroundColor Green
}

# 3) uuid-ossp o fallback pgcrypto
Write-Host "`n[3] Extensión/uuid ..." -ForegroundColor Cyan
try {
  Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql 'CREATE EXTENSION IF NOT EXISTS "uuid-ossp";' -Quiet
  Write-Host " - uuid-ossp OK" -ForegroundColor Green
} catch {
  Write-Host " - uuid-ossp no disponible; usando pgcrypto + alias" -ForegroundColor Yellow
  Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql "CREATE EXTENSION IF NOT EXISTS pgcrypto;" -Quiet
  $hasFn = Run-PSQL-Query -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql "SELECT 1 FROM pg_proc WHERE proname='uuid_generate_v4';"
  if ([string]::IsNullOrWhiteSpace($hasFn)) {
    Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql @'
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname='uuid_generate_v4') THEN
    EXECUTE 'CREATE OR REPLACE FUNCTION uuid_generate_v4() RETURNS uuid AS $$ SELECT gen_random_uuid() $$ LANGUAGE SQL VOLATILE';
  END IF;
END
$$;
'@ -Quiet
  }
}

# 4) Esquema completo (ENUMs + tablas + columnas) - idempotente
Write-Host "`n[4] Esquema (ENUMs/Tablas/Columnas) ..." -ForegroundColor Cyan
$ddl = @'
DO $do$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname='rooms_status_enum') THEN
    CREATE TYPE rooms_status_enum AS ENUM ('waiting','running','ended');
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname='ticket_status_enum') THEN
    CREATE TYPE ticket_status_enum AS ENUM ('active','won_line','won_corners','won_bingo','void');
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname='claims_type_enum') THEN
    CREATE TYPE claims_type_enum AS ENUM ('line','bingo','corners');
  END IF;
END
$do$;

CREATE TABLE IF NOT EXISTS public.users (
  id         uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  name       varchar(64)  NOT NULL,
  balance    integer      NOT NULL DEFAULT 0,
  created_at timestamptz  NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.rooms (
  id                  uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  token               varchar(64)       NOT NULL,
  status              rooms_status_enum NOT NULL DEFAULT 'waiting',
  game_type           varchar(16)       NOT NULL DEFAULT '75',
  created_at          timestamptz       NOT NULL DEFAULT now(),
  started_at          timestamptz       NULL,
  ended_at            timestamptz       NULL,
  host_id             uuid              NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  scheduled_start_at  timestamp         NULL,
  meta                jsonb             NULL
);

DO $do$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_constraint WHERE conname='rooms_token_key'
  ) THEN
    ALTER TABLE public.rooms ADD CONSTRAINT rooms_token_key UNIQUE (token);
  END IF;
END
$do$;

CREATE TABLE IF NOT EXISTS public.room_participants (
  id        uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  room_id   uuid NOT NULL REFERENCES public.rooms(id) ON DELETE CASCADE,
  user_id   uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  joined_at timestamptz NOT NULL DEFAULT now()
);

DO $do$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_constraint WHERE conname='room_participants_room_id_user_id_key'
  ) THEN
    ALTER TABLE public.room_participants
      ADD CONSTRAINT room_participants_room_id_user_id_key UNIQUE (room_id, user_id);
  END IF;
END
$do$;

CREATE TABLE IF NOT EXISTS public.tickets (
  id         uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  room_id    uuid NOT NULL REFERENCES public.rooms(id) ON DELETE CASCADE,
  user_id    uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  grid       jsonb NOT NULL,
  status     ticket_status_enum NOT NULL DEFAULT 'active',
  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.purchases (
  id         uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  room_id    uuid NOT NULL REFERENCES public.rooms(id) ON DELETE CASCADE,
  user_id    uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  quantity   integer NOT NULL,
  total_cost integer NOT NULL,
  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.draws (
  id         uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  room_id    uuid NOT NULL REFERENCES public.rooms(id) ON DELETE CASCADE,
  number     integer NOT NULL,
  "order"    integer NOT NULL,
  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.claims (
  id         uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
  room_id    uuid NOT NULL REFERENCES public.rooms(id) ON DELETE CASCADE,
  user_id    uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  ticket_id  uuid NOT NULL REFERENCES public.tickets(id) ON DELETE CASCADE,
  type       claims_type_enum NOT NULL,
  valid      boolean NOT NULL DEFAULT false,
  draw_index integer NULL,
  reason     text    NULL,
  created_at timestamptz NOT NULL DEFAULT now()
);

-- columnas por si faltan
ALTER TABLE public.rooms            ADD COLUMN IF NOT EXISTS scheduled_start_at timestamp NULL;
ALTER TABLE public.rooms            ADD COLUMN IF NOT EXISTS meta jsonb NULL;
UPDATE public.rooms SET meta='{}'::jsonb WHERE meta IS NULL;

ALTER TABLE public.room_participants ADD COLUMN IF NOT EXISTS joined_at timestamptz NOT NULL DEFAULT now();
ALTER TABLE public.tickets          ADD COLUMN IF NOT EXISTS created_at timestamptz NOT NULL DEFAULT now();
ALTER TABLE public.purchases        ADD COLUMN IF NOT EXISTS created_at timestamptz NOT NULL DEFAULT now();
ALTER TABLE public.draws            ADD COLUMN IF NOT EXISTS created_at timestamptz NOT NULL DEFAULT now();
ALTER TABLE public.claims           ADD COLUMN IF NOT EXISTS created_at timestamptz NOT NULL DEFAULT now();
ALTER TABLE public.users            ADD COLUMN IF NOT EXISTS created_at timestamptz NOT NULL DEFAULT now();
'@

# Enviar el DDL por stdin con -f -
$prev = $env:PGPASSWORD
try {
  $env:PGPASSWORD = $SUPER_PASS
  $ddl | psql -h $PGHOST -p $PGPORT -U $SUPER_USER -d $DBNAME -X --no-psqlrc -v ON_ERROR_STOP=1 -f -
  if ($LASTEXITCODE -ne 0) { throw "psql exitcode $LASTEXITCODE" }
} finally {
  $env:PGPASSWORD = $prev
}

# 5) Permisos para el usuario app
Write-Host "`n[5] Permisos ..." -ForegroundColor Cyan
Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql "ALTER SCHEMA public OWNER TO $APP_USER;" -Quiet
Run-PSQL -User $SUPER_USER -Pass $SUPER_PASS -Db $DBNAME -Sql "GRANT ALL ON SCHEMA public TO $APP_USER;" -Quiet

# 6) Verificación final
Write-Host "`n[6] Verificación ..." -ForegroundColor Cyan
$tables = Run-PSQL-Query -User $APP_USER -Pass $APP_PASS -Db $DBNAME -Sql "select table_name from information_schema.tables where table_schema='public' order by 1;"
Write-Host ($tables -replace "`n", "`r`n")
Write-Host "`nOK: esquema listo." -ForegroundColor Green
