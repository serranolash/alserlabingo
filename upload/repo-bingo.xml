import {
  Entity,
  PrimaryGeneratedColumn,
  ManyToOne,
  OneToMany,
  JoinColumn,
  Column,
  CreateDateColumn,
  RelationId,
} from 'typeorm';
import { Room } from './room.entity';
import { User } from './user.entity';
import { Claim } from './claim.entity';

@Entity('tickets')
export class Ticket {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @ManyToOne(() => Room, (r) => r.tickets, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'room_id' })
  room: Room;

  @RelationId((t: Ticket) => t.room)
  readonly roomId: string;

  @ManyToOne(() => User, (u) => u.tickets, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'user_id' })
  user: User;

  @RelationId((t: Ticket) => t.user)
  readonly userId: string;

  // grid se guarda como JSONB (ver parche SQL previo)
  @Column({ type: 'jsonb' })
  grid: number[][];

  // extendemos el union para cubrir los estados usados por el servicio
  @Column({ type: 'text', default: 'active' })
  status: 'active' | 'used' | 'cancelled' | 'won_line' | 'won_corners' | 'won_bingo';

  @CreateDateColumn({ name: 'created_at' })
  createdAt: Date;

  // relación inversa para claims (soluciona t => t.claims)
  @OneToMany(() => Claim, (c) => c.ticket, { cascade: false })
  claims: Claim[];
}
</file>

