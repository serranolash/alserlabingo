// src/entities/room.entity.ts
import {
  Entity,
  PrimaryGeneratedColumn,
  Column,
  CreateDateColumn,
  ManyToOne,
  OneToMany,
  JoinColumn,
  RelationId,
} from 'typeorm';
import { User } from './user.entity';
import { RoomParticipant } from './room-participant.entity';
import { Ticket } from './ticket.entity';
import { Purchase } from './purchase.entity';
import { Draw } from './draw.entity';
import { Claim } from './claim.entity';

export type RoomStatus = 'waiting' | 'running' | 'ended';

// Tipos opcionales para ayudarte en el código (no afectan la BD)
export type PrizeMeta = {
  currency: 'USD' | 'EUR' | 'ARS' | 'BRL' | 'CLP';
  line: number;
  corners: number;
  bingo: number;
};

export type CalendarItemMeta = {
  id: string;
  ts: number;     // epoch millis
  note?: string;
};

@Entity('rooms')
export class Room {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Column({ type: 'varchar', length: 32, unique: true })
  token: string;

  @Column({ type: 'varchar', length: 16, default: 'waiting' })
  status: RoomStatus;

  // “75” para bingo americano 75 bolas; lo dejamos como texto simple.
  @Column({ name: 'game_type', type: 'varchar', length: 16, default: '75' })
  gameType: string;

  @CreateDateColumn({ name: 'created_at' })
  createdAt: Date;

  @Column({ name: 'started_at', type: 'timestamp', nullable: true })
  startedAt?: Date | null;

  @Column({ name: 'ended_at', type: 'timestamp', nullable: true })
  endedAt?: Date | null;

  /**
   * FK al anfitrión — columna real en BD: host_id (uuid NOT NULL REFERENCES users(id))
   * NO declares un @Column para hostId; usa RelationId para exponer el valor sin duplicar columnas.
   */
  @ManyToOne(() => User, (u) => u.hostedRooms, { nullable: false })
  @JoinColumn({ name: 'host_id' })
  host: User;

  @RelationId((room: Room) => room.host)
  readonly hostId: string;

  @OneToMany(() => RoomParticipant, (p) => p.room)
  participants: RoomParticipant[];

  @OneToMany(() => Ticket, (t) => t.room)
  tickets: Ticket[];

  @OneToMany(() => Purchase, (p) => p.room)
  purchases: Purchase[];

  @OneToMany(() => Draw, (d) => d.room)
  draws: Draw[];

  @OneToMany(() => Claim, (c) => c.room)
  claims: Claim[];

  // NUEVO: meta configurable (premios/calendario) sin romper el esquema actual
  @Column({ type: 'jsonb', nullable: true })
  meta?: {
    prize?: PrizeMeta;
    calendar?: CalendarItemMeta[];
  };

  @Column({ name: 'scheduled_start_at', type: 'timestamp', nullable: true })
  scheduledStartAt?: Date | null;
}
</file>

