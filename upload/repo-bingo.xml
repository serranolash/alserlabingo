export type Cell = number | string;
export type Board = Cell[][]; // 5x5

const FREE = 'FREE';

/** Convierte a número si aplica, permite 'FREE' */
function normalizeCell(c: Cell): number | 'FREE' {
  if (typeof c === 'number') return c;
  if (typeof c === 'string') {
    const t = c.trim().toUpperCase();
    if (t === FREE) return FREE;
    const n = Number(t);
    if (!Number.isNaN(n)) return n;
  }
  // Si viniera algo raro, lo tratamos como no marcado.
  return NaN;
}

export function hasLine(board: Board, drawn: Set<number>): boolean {
  // filas
  for (let r = 0; r < 5; r++) {
    let ok = true;
    for (let c = 0; c < 5; c++) {
      const v = normalizeCell(board[r][c]);
      if (v !== FREE && !drawn.has(Number(v))) { ok = false; break; }
    }
    if (ok) return true;
  }

  // columnas
  for (let c = 0; c < 5; c++) {
    let ok = true;
    for (let r = 0; r < 5; r++) {
      const v = normalizeCell(board[r][c]);
      if (v !== FREE && !drawn.has(Number(v))) { ok = false; break; }
    }
    if (ok) return true;
  }

  // (opcional) diagonales -> descomenta si tu juego las paga como línea:
  // let okDiag1 = true, okDiag2 = true;
  // for (let i=0;i<5;i++){
  //   const v1 = normalizeCell(board[i][i]);
  //   const v2 = normalizeCell(board[i][4-i]);
  //   if (v1 !== FREE && !drawn.has(Number(v1))) okDiag1=false;
  //   if (v2 !== FREE && !drawn.has(Number(v2))) okDiag2=false;
  // }
  // if (okDiag1 || okDiag2) return true;

  return false;
}

export function isBingo(board: Board, drawn: Set<number>): boolean {
  for (let r = 0; r < 5; r++) {
    for (let c = 0; c < 5; c++) {
      const v = normalizeCell(board[r][c]);
      if (v !== FREE && !drawn.has(Number(v))) return false;
    }
  }
  return true;
}
