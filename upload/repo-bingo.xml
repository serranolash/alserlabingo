// src/rooms/bingo.ts

export type Grid = (number | null)[][]; // 5x5

export function generateBingo75Card(): Grid {
  const ranges = [
    { start: 1, end: 15 },
    { start: 16, end: 30 },
    { start: 31, end: 45 },
    { start: 46, end: 60 },
    { start: 61, end: 75 },
  ];
  const grid: Grid = Array.from({ length: 5 }, () => Array(5).fill(0));

  for (let col = 0; col < 5; col++) {
    const nums = shuffle(range(ranges[col].start, ranges[col].end));
    for (let row = 0; row < 5; row++) {
      grid[row][col] = nums[row];
    }
  }
  grid[2][2] = null; // centro libre
  return grid;
}

export function hasLine(grid: Grid, drawn: Set<number>): boolean {
  // filas
  for (let r = 0; r < 5; r++) {
    if (grid[r].every((v) => v === null || drawn.has(v))) return true;
  }
  // columnas
  for (let c = 0; c < 5; c++) {
    let ok = true;
    for (let r = 0; r < 5; r++) {
      const v = grid[r][c];
      if (v !== null && !drawn.has(v)) {
        ok = false;
        break;
      }
    }
    if (ok) return true;
  }
  // diagonales
  const d1 = [0, 1, 2, 3, 4].every((i) => grid[i][i] === null || drawn.has(grid[i][i]!));
  const d2 = [0, 1, 2, 3, 4].every((i) => grid[i][4 - i] === null || drawn.has(grid[i][4 - i]!));
  return d1 || d2;
}

/**
 * Valida la condición "cuatro esquinas":
 * las posiciones (0,0), (0,4), (4,0) y (4,4) deben estar marcadas.
 * Un valor null (casilla libre) cuenta como marcada.
 */
export function hasFourCorners(grid: Grid, drawn: Set<number>): boolean {
  const rows = grid.length;
  const cols = grid[0]?.length ?? 0;
  if (rows < 5 || cols < 5) return false; // seguridad por si llega otra dimensión

  const corners: Array<number | null> = [
    grid[0][0],
    grid[0][cols - 1],
    grid[rows - 1][0],
    grid[rows - 1][cols - 1],
  ];

  return corners.every((v) => v === null || drawn.has(v));
}

export function hasBingo(grid: Grid, drawn: Set<number>): boolean {
  for (let r = 0; r < 5; r++) {
    for (let c = 0; c < 5; c++) {
      const v = grid[r][c];
      if (v !== null && !drawn.has(v)) return false;
    }
  }
  return true;
}

export function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

export function range(a: number, b: number): number[] {
  const out: number[] = [];
  for (let i = a; i <= b; i++) out.push(i);
  return out;
}
