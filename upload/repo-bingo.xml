import {
  Entity,
  PrimaryGeneratedColumn,
  ManyToOne,
  JoinColumn,
  Column,
  CreateDateColumn,
  RelationId,
} from 'typeorm';
import { Room } from './room.entity';
import { User } from './user.entity';
import { Ticket } from './ticket.entity';

@Entity('claims')
export class Claim {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @ManyToOne(() => Room, (r) => r.claims, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'room_id' })
  room: Room;

  @RelationId((c: Claim) => c.room)
  readonly roomId: string;

  @ManyToOne(() => User, (u) => u.claims, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'user_id' })
  user: User;

  @RelationId((c: Claim) => c.user)
  readonly userId: string;

  @ManyToOne(() => Ticket, (t) => t.claims, { onDelete: 'SET NULL', nullable: true })
  @JoinColumn({ name: 'ticket_id' })
  ticket: Ticket | null;

  @RelationId((c: Claim) => c.ticket)
  readonly ticketId: string | null;

  @Column({ type: 'text' })
  type: 'line' | 'corners' | 'bingo';

  @Column({ type: 'boolean', default: false })
  valid: boolean;

  @Column({ name: 'draw_index', type: 'int', nullable: true })
  drawIndex: number | null;

  @Column({ type: 'text', nullable: true })
  reason: string | null;

  @CreateDateColumn({ name: 'created_at' })
  createdAt: Date;
}
</file>

