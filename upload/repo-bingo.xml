<file path="setup-postgres-bingo.ps1">
param(
  [ValidateSet('service')]
  [string]$Mode = 'service',
  [string]$DbHost = '127.0.0.1',
  [int]$DbPort = 5432,

  # Superusuario para crear rol/DB (ajústalo a tu instalación)
  [string]$SuperUser = 'postgres',
  [string]$SuperPass = 'postgres',

  # Usuario/BD de la app
  [string]$AppUser = 'bingo',
  [string]$AppPass = 'bingo',
  [string]$DatabaseName = 'bingo',

  [switch]$RunMigrations
)

function Write-OK   ($m){ Write-Host "[ OK ] $m"   -ForegroundColor Green }
function Write-Info ($m){ Write-Host "[INFO] $m"  -ForegroundColor Cyan }
function Write-Err  ($m){ Write-Host "[ERR ] $m"  -ForegroundColor Red }

function Find-Psql {
  $cmd = Get-Command psql -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  $cands = @(
    "C:\Program Files\PostgreSQL\16\bin\psql.exe",
    "C:\Program Files\PostgreSQL\15\bin\psql.exe",
    "C:\Program Files\PostgreSQL\14\bin\psql.exe"
  )
  foreach ($p in $cands) { if (Test-Path $p) { return $p } }
  return $null
}

# Evita el nombre reservado $Host de PowerShell
function Wait-TcpPort {
  param([string]$TargetHost, [int]$Port, [int]$TimeoutSec = 90)
  Write-Info "Esperando PostgreSQL en $TargetHost`:$Port (timeout ${TimeoutSec}s)..."
  $stop = (Get-Date).AddSeconds($TimeoutSec)
  while ((Get-Date) -lt $stop) {
    try {
      if (Test-NetConnection -ComputerName $TargetHost -Port $Port -InformationLevel Quiet) {
        Write-OK "Puerto accesible."; return $true
      }
    } catch {}
    Start-Sleep -Milliseconds 600
  }
  Write-Err "No se pudo conectar a $TargetHost`:$Port dentro del tiempo."
  return $false
}

# ---------- FIX PRINCIPAL: psql con ArgumentList real ----------
function Exec-psql {
  param([string]$Db='postgres', [string]$Sql='', [switch]$Quiet)

  $psql = Find-Psql
  if (-not $psql) { throw "psql no encontrado. Instala PostgreSQL o agrega psql al PATH." }

  $env:PGPASSWORD = $SuperPass

  $args = @(
    '-X', '-h', $DbHost, '-p', "$DbPort", '-U', $SuperUser, '-d', $Db
  )
  if ($Quiet) { $args += @('-A','-t') }
  $args += @('-v','ON_ERROR_STOP=1','-c', $Sql)

  # Redirigimos para capturar ambos streams sin problemas de quoting
  $tmpOut = [System.IO.Path]::GetTempFileName()
  $tmpErr = [System.IO.Path]::GetTempFileName()
  try {
    & $psql @args 1> $tmpOut 2> $tmpErr
    $code = $LASTEXITCODE
    $stdout = (Get-Content -Raw -Path $tmpOut) 2>$null
    $stderr = (Get-Content -Raw -Path $tmpErr) 2>$null

    if ($code -ne 0) {
      Write-Err "psql falló sobre DB='$Db' (User='$SuperUser')."
      if ($stderr) { Write-Host $stderr -ForegroundColor Red }
      if ($stdout) { Write-Host $stdout -ForegroundColor DarkRed }
      throw "psql exit code $code"
    }
    if (-not $Quiet -and $stdout) { Write-Host $stdout }
    return $stdout
  }
  finally {
    Remove-Item $tmpOut,$tmpErr -ErrorAction SilentlyContinue
  }
}
# ----------------------------------------------------------------

function Test-NpmScript { param([string]$ScriptName)
  try {
    $pkg = Get-Content -Raw -Path ".\package.json" | ConvertFrom-Json
    return ($pkg.scripts.PSObject.Properties.Name -contains $ScriptName)
  } catch { return $false }
}

# ---------------- MAIN ----------------
$psqlPath = Find-Psql
if (-not $psqlPath) { throw "psql no encontrado. Instala PostgreSQL." }
Write-OK "psql: $psqlPath"

if ($Mode -eq 'service') {
  try {
    $svc = Get-Service -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^postgres' }
    if ($svc -and $svc.Status -ne 'Running') { Start-Service $svc.Name }
    Write-OK "Servicio de PostgreSQL ya está ejecutándose."
  } catch {}
}

if (-not (Wait-TcpPort -TargetHost $DbHost -Port $DbPort -TimeoutSec 90)) { exit 1 }

Write-Info "Probando conexión a BD 'postgres'..."
Exec-psql -Db 'postgres' -Sql "SELECT version();"
Write-OK "Conexión ok."

Write-Info "Creando rol '$AppUser' y base '$DatabaseName' si no existen..."

# 1) Rol
$existsRole = (Exec-psql -Db 'postgres' -Sql ("SELECT 1 FROM pg_roles WHERE rolname = '{0}';" -f $AppUser.Replace("'","''")) -Quiet).Trim()
if ($existsRole -ne '1') {
  Exec-psql -Db 'postgres' -Sql ("CREATE ROLE {0} LOGIN PASSWORD '{1}';" -f $AppUser.Replace("'","''"), $AppPass.Replace("'","''"))
  Write-OK "Rol '$AppUser' creado."
} else {
  Write-OK "Rol '$AppUser' ya existe."
}

# 2) BD
$existsDb = (Exec-psql -Db 'postgres' -Sql ("SELECT 1 FROM pg_database WHERE datname = '{0}';" -f $DatabaseName.Replace("'","''")) -Quiet).Trim()
if ($existsDb -ne '1') {
  Exec-psql -Db 'postgres' -Sql ("CREATE DATABASE {0} OWNER {1};" -f $DatabaseName, $AppUser)
  Write-OK "Base '$DatabaseName' creada."
} else {
  Write-OK "Base '$DatabaseName' ya existe."
}

# 3) Permisos
Exec-psql -Db $DatabaseName -Sql ("REVOKE CREATE ON SCHEMA public FROM PUBLIC;")
Exec-psql -Db $DatabaseName -Sql ("GRANT CONNECT ON DATABASE {0} TO {1};" -f $DatabaseName, $AppUser)
Exec-psql -Db $DatabaseName -Sql ("GRANT USAGE   ON SCHEMA public TO {0};" -f $AppUser)
Exec-psql -Db $DatabaseName -Sql ("ALTER DATABASE {0} OWNER TO {1};" -f $DatabaseName, $AppUser)

Write-Info "Verificación rápida de tablas:"
Exec-psql -Db $DatabaseName -Sql "SELECT COALESCE(to_regclass('public.rooms')::text,'(sin tabla rooms)') AS rooms, COALESCE(to_regclass('public.users')::text,'(sin tabla users)') AS users;"

# 4) Migraciones
if ($RunMigrations) {
  if (Test-Path .\package.json) {
    if (Test-NpmScript 'migration:run') {
      Write-Info "Ejecutando: npm run migration:run"
      npm run migration:run
      if ($LASTEXITCODE -ne 0) { Write-Err "Fallo npm run migration:run"; exit 1 }
    } elseif (Test-NpmScript 'typeorm:migration:run') {
      Write-Info "Ejecutando: npm run typeorm:migration:run"
      npm run typeorm:migration:run
      if ($LASTEXITCODE -ne 0) { Write-Err "Fallo npm run typeorm:migration:run"; exit 1 }
    } else {
      Write-Info "No hay script de migraciones en package.json. Saltando."
    }
  } else {
    Write-Info "No hay package.json en este directorio. Saltando migraciones."
  }
}

Write-OK ("Todo listo. Backend puede conectarse a postgres://{0}:****@{1}:{2}/{3}" -f $AppUser,$DbHost,$DbPort,$DatabaseName)
</file>

