// src/main.ts
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import { Logger } from '@nestjs/common';

const clean = (v?: string, def = '') =>
  String(v ?? def)
    .replace(/^\uFEFF/, '')
    .replace(/[\u200B-\u200D\u2060]/g, '')
    .replace(/^[\s"'`]+|[\s"'`]+$/g, '')
    .trim();

async function ensureDatabaseExistsIfAsked() {
  const wantBootstrap = String(process.env.DB_BOOTSTRAP || 'false').toLowerCase() === 'true';
  if (!wantBootstrap) {
    Logger.log('[DB] Bootstrap desactivado (DB_BOOTSTRAP=false)', 'Bootstrap');
    return;
  }

  const { Client } = require('pg');
  const host    = clean(process.env.DB_HOST, '127.0.0.1');
  const port    = Number(clean(process.env.DB_PORT, '5432'));
  const dbName  = clean(process.env.DB_NAME, 'bingo');
  const appUser = clean(process.env.DB_USER, 'bingo');
  const appPass = clean(process.env.DB_PASS, 'bingo');

  // Usa SIEMPRE credenciales de admin explícitas para el pre-flight
  const suUser = clean(process.env.DB_ADMIN_USER, '');
  const suPass = clean(process.env.DB_ADMIN_PASS, '');
  const suDB   = clean(process.env.DB_ADMIN_DB, 'postgres');
  if (!suUser) {
    Logger.warn('[DB] Bootstrap activo pero sin DB_ADMIN_USER; se omite.', 'Bootstrap');
    return;
  }

  let cli: any;
  try {
    cli = new Client({ host, port, user: suUser, password: suPass, database: suDB });
    await cli.connect();

    // Rol de app (idempotente)
    const roleExists = await cli.query('SELECT 1 FROM pg_roles WHERE rolname=$1', [appUser]);
    if (roleExists.rowCount === 0) {
      await cli.query(`CREATE ROLE "${appUser}" LOGIN PASSWORD $1`, [appPass]);
      Logger.log(`[DB] Rol "${appUser}" creado`, 'Bootstrap');
    } else {
      await cli.query(`ALTER ROLE "${appUser}" WITH LOGIN PASSWORD $1`, [appPass]);
      Logger.log(`[DB] Rol "${appUser}" actualizado`, 'Bootstrap');
    }

    // DB de app (idempotente)
    const dbExists = await cli.query('SELECT 1 FROM pg_database WHERE datname=$1', [dbName]);
    if (dbExists.rowCount === 0) {
      Logger.log(`[DB] Creando base "${dbName}"…`, 'Bootstrap');
      await cli.query(`CREATE DATABASE "${dbName}" OWNER "${appUser}" TEMPLATE template0 ENCODING 'UTF8'`);
      Logger.log(`[DB] Base "${dbName}" creada`, 'Bootstrap');
    } else {
      Logger.log(`[DB] Base "${dbName}" ya existe`, 'Bootstrap');
    }
  } catch (e:any) {
    Logger.warn(`[DB] Pre-flight omitido: ${e?.message ?? e}`, 'Bootstrap');
  } finally {
    if (cli) try { await cli.end(); } catch {}
  }
}

async function bootstrap() {
  await ensureDatabaseExistsIfAsked(); // ← ahora solo corre si lo pedís
  const app = await NestFactory.create(AppModule, { logger: ['log','warn','error'] });
  app.enableCors({ origin: '*', credentials: true });
  await app.listen(Number(process.env.PORT || 3000));
  console.log(`API on http://localhost:${process.env.PORT || 3000}`);
}
bootstrap();
