// src/gateway/game.gateway.ts
import {
  WebSocketGateway,
  WebSocketServer,
  SubscribeMessage,
  MessageBody,
  ConnectedSocket,
} from '@nestjs/websockets';
import { Server, Socket } from 'socket.io';

type RoomStatusPayload = {
  status: 'waiting' | 'running' | 'ended';
  startedAt?: Date;
  endedAt?: Date;
};

// Soporta 'line' | 'bingo' | 'corners'
type WinKind = 'line' | 'bingo' | 'corners';

/**
 * Payload de ganador(es).
 * - Mantiene compat con tu versión previa (winners[] opcional).
 * - Suma los nuevos opcionales: prizePerWinner, winnersCount.
 */
export interface WinPayload {
  type: WinKind;
  userId: string;
  ticketId: string;
  drawIndex: number;
  // Nuevos opcionales (co-ganadores / premio dividido)
  prizePerWinner?: number;
  winnersCount?: number;
  // Compat previo: lista detallada de ganadores (opcional)

  userName?: string;        // <--- esto elimina el TS2353
  prizeLabel?: string;      // p.ej. "Línea", "Esquinas", "Bingo"
  prizeTotal?: number;      // opcional: total del premio configurado
  winners?: Array<{ userId: string; ticketId: string }>;
}

type ClaimPayload = {
  type: WinKind; // también admite 'corners'
  userId: string;
  ticketId: string;
  drawIndex: number;
  valid: boolean;
};

type PurchasePayload = {
  userId: string;
  quantity: number;
  tickets?: Array<{ id: string; grid: number[][] }>;
  newBalance?: number;
};

type PlayerJoinedPayload = {
  userId: string;
  name?: string;
  balance?: number;
};

@WebSocketGateway({
  cors: { origin: true, credentials: true },
})
export class GameGateway {
  @WebSocketServer()
  server!: Server;

  // ======= Suscripción básica: cliente se une a la sala =======
  @SubscribeMessage('join_room')
  handleJoinRoom(
    @MessageBody() data: { roomId?: string; name?: string; userId?: string },
    @ConnectedSocket() client: Socket,
  ) {
    const roomId = String(data?.roomId ?? '');
    if (!roomId) return;
    client.join(roomId);
    // notificación ligera para refrescar listas
    this.server.to(roomId).emit('participants_update', {
      userId: data?.userId ?? client.id,
      name: data?.name,
    });
  }

  // ================= Emisores usados por RoomsService =================

  broadcastRoomCreated(payload: {
    roomId: string;
    token: string;
    hostUserId: string;
    inviteUrl?: string;
  }) {
    this.server.emit('room_created', payload);
  }

  broadcastRoomStatus(roomId: string, payload: RoomStatusPayload) {
    this.server.to(roomId).emit('room_status', payload);
  }

  broadcastState(roomId: string, state: any) {
    // Compat: algunos front escuchan 'room_state' y otros 'state'
    this.server.to(roomId).emit('room_state', state);
    this.server.to(roomId).emit('state', state);
  }

  broadcastDraw(roomId: string, payload: { number: number; order: number }) {
    // Compat: 'draw' (solo número) y 'draw_number'
    this.server.to(roomId).emit('draw', payload.number);
    this.server.to(roomId).emit('draw_number', payload.number);
  }

  broadcastPurchase(roomId: string, payload: PurchasePayload) {
    this.server.to(roomId).emit('purchase_update', payload);
  }

  broadcastPlayerJoined(roomId: string, payload: PlayerJoinedPayload) {
    this.server.to(roomId).emit('participants_update', payload);
  }

  broadcastClaim(roomId: string, payload: ClaimPayload) {
    this.server.to(roomId).emit('claim_update', payload);
  }

  /**
   * Win: emite en ambos canales para compatibilidad:
   * - 'win' (tu nuevo evento solicitado)
   * - 'claim_update' con valid=true (muchos front ya lo consumen)
   * Además, mantenemos 'win_update' opcional por retrocompat.
   */
  broadcastWin(roomId: string, payload: WinPayload) {
    // Nuevo evento explícito de win
    this.server.to(roomId).emit('win', payload);

    // Compat con flujos que usan claim_update como "evento de ganador"
    this.server.to(roomId).emit('claim_update', { ...payload, valid: true });

    // Compat adicional (si algún front viejo escucha 'win_update')
    this.server.to(roomId).emit('win_update', payload);
  }

  broadcastRoomReset(roomId: string) {
    // El front actual no necesita payload
    this.server.to(roomId).emit('room_reset');
  }

  broadcastRoundScheduled(roomId: string, startAt: string) {
    this.server.to(roomId).emit('round_scheduled', { roomId, startAt });
  }
}
</file>

