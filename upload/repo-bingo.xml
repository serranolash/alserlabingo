// src/rooms/rooms.service.ts 
import {
  Injectable,
  BadRequestException,
  NotFoundException,
  ForbiddenException,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';

import { User } from '../entities/user.entity';
import { Room } from '../entities/room.entity';
import { RoomParticipant } from '../entities/room-participant.entity';
import { Ticket } from '../entities/ticket.entity';
import { Purchase } from '../entities/purchase.entity';
import { Draw } from '../entities/draw.entity';
import { Claim } from '../entities/claim.entity';
import { GameGateway } from '../gateway/game.gateway';

import {
  CreateRoomDto,
  JoinRoomDto,
  BuyCardsDto,
  StartRoomDto,
  ClaimDto,
} from './dto';

import {
  generateBingo75Card,
  hasBingo,
  hasLine,
  shuffle,
  range,
  hasFourCorners,
} from './bingo';
import { randomBytes } from 'crypto';

type TimerInfo = {
  timer: NodeJS.Timeout | null;
  bag: number[];
  order: number;
};

type PrizeKind = 'line' | 'corners' | 'bingo';

@Injectable()
export class RoomsService {
  constructor(
    @InjectRepository(User) private readonly usersRepo: Repository<User>,
    @InjectRepository(Room) private readonly roomsRepo: Repository<Room>,
    @InjectRepository(RoomParticipant)
    private readonly rpartsRepo: Repository<RoomParticipant>,
    @InjectRepository(Ticket) private readonly ticketsRepo: Repository<Ticket>,
    @InjectRepository(Purchase)
    private readonly purchasesRepo: Repository<Purchase>,
    @InjectRepository(Draw) private readonly drawsRepo: Repository<Draw>,
    @InjectRepository(Claim) private readonly claimsRepo: Repository<Claim>,
    private readonly gateway: GameGateway,
  ) {}

  private timers = new Map<string, TimerInfo>();
  private readonly ALL_NUMBERS: number[] = Array.from({ length: 75 }, (_, i) => i + 1);

  // === PROGRAMACIÓN DE SALA (nuevo) ===
  private scheduleTimers = new Map<string, NodeJS.Timeout>();

  // --------- Helpers de meta (calendar y premios) ----------
  private buildPublicMeta(room: Room) {
    const m = (room.meta ?? {}) as any;

    // Defaults desde ENV si no hay configuración
    const PRIZE_LINE    = Number(process.env.PRIZE_LINE ?? 100);
    const PRIZE_CORNERS = Number(process.env.PRIZE_CORNERS ?? 80);
    const PRIZE_BINGO   = Number(process.env.PRIZE_BINGO ?? 300);

    // Permite dos formatos en BD:
    // 1) prizes: { line: 5000, corners: 3000, bingo: 10000 }
    // 2) prizes: { line: { amount: 5000, label: 'Línea' }, ... }
    const normalizePrize = (val: any, defAmount: number, defLabel: string) => {
      if (val == null) return { amount: defAmount, label: defLabel };
      if (typeof val === 'number') return { amount: Number(val), label: defLabel };
      if (typeof val === 'object') {
        return {
          amount: Number(val.amount ?? defAmount),
          label: String(val.label ?? defLabel),
        };
      }
      return { amount: defAmount, label: defLabel };
    };

    const prizes = {
      line:    normalizePrize(m?.prizes?.line,    PRIZE_LINE,    'Línea'),
      corners: normalizePrize(m?.prizes?.corners, PRIZE_CORNERS, 'Esquinas'),
      bingo:   normalizePrize(m?.prizes?.bingo,   PRIZE_BINGO,   'Bingo'),
    };

    // Calendar: usa meta.calendar si existe; si no, toma scheduledStartAt
    const calendar = Array.isArray(m?.calendar)
      ? m.calendar
      : (room.scheduledStartAt ? [room.scheduledStartAt.toISOString()] : []);

    return {
      ...m,
      prizes,
      calendar,
    };
  }

  // ===================== CREACIÓN / JOIN / COMPRA =====================

  async createRoom(dto: CreateRoomDto, appUrl: string) {
    const host = this.usersRepo.create({
      name: dto.hostName,
      balance: Number(process.env.INITIAL_CREDITS || 1000),
    });
    await this.usersRepo.save(host);

    const token = randomBytes(8).toString('hex');
    const room = this.roomsRepo.create({
      host,
      token,
      status: 'waiting',
      gameType: '75',
    });
    await this.roomsRepo.save(room);

    const rp = this.rpartsRepo.create({ room, user: host });
    await this.rpartsRepo.save(rp);

    const cleaned = appUrl.replace(/\/+$/, '');
    const inviteUrl = `${cleaned}/invite/${token}`;

    this.gateway.broadcastRoomCreated({
      roomId: room.id,
      token,
      hostUserId: host.id,
      inviteUrl,
    });

    return { roomId: room.id, token, inviteUrl, hostUserId: host.id };
  }

  async joinRoom(dto: JoinRoomDto) {
    const room = await this.roomsRepo.findOne({
      where: { token: dto.token },
      relations: ['host'],
    });
    if (!room) throw new NotFoundException('Sala no encontrada');

    const user = this.usersRepo.create({
      name: dto.playerName,
      balance: Number(process.env.INITIAL_CREDITS || 1000),
    });
    await this.usersRepo.save(user);

    try { await this.rpartsRepo.save(this.rpartsRepo.create({ room, user })); } catch {}

    this.gateway.broadcastPlayerJoined(room.id, {
      userId: user.id,
      name: user.name,
      balance: user.balance,
    });

    return {
      roomId: room.id,
      userId: user.id,
      balance: user.balance,
      status: room.status,
    };
  }

  async buyCards(roomId: string, dto: BuyCardsDto) {
    const [room, user] = await Promise.all([
      this.roomsRepo.findOne({ where: { id: roomId }, relations: ['host'] }),
      this.usersRepo.findOne({ where: { id: dto.userId } }),
    ]);

    if (!room) throw new NotFoundException('Sala no encontrada');
    if (!user) throw new NotFoundException('Usuario no encontrado');

    if (room.status !== 'waiting') {
      throw new BadRequestException('La compra solo está permitida antes de iniciar');
    }

    const price = Number(process.env.CARD_PRICE || 100);
    const total = price * dto.quantity;
    if (user.balance < total) throw new BadRequestException('Fondos insuficientes');

    user.balance -= total;
    await this.usersRepo.save(user);

    await this.purchasesRepo.save(
      this.purchasesRepo.create({
        user,
        room,
        quantity: dto.quantity,
        totalCost: total,
      }),
    );

    const tickets: Ticket[] = [];
    for (let i = 0; i < dto.quantity; i++) {
      const grid = generateBingo75Card(); // 5x5
      const t = this.ticketsRepo.create({ room, user, grid, status: 'active' });
      tickets.push(await this.ticketsRepo.save(t));
    }

    this.gateway.broadcastPurchase(roomId, {
      userId: user.id,
      quantity: dto.quantity,
      tickets: tickets.map(t => ({ id: t.id, grid: t.grid })),
      newBalance: user.balance,
    });

    return { balance: user.balance, tickets };
  }

  // ======================= INICIO / REANUDAR / ESTADO =======================

  async startRoom(roomId: string, dto: StartRoomDto) {
    const room = await this.roomsRepo.findOne({
      where: { id: roomId },
      relations: ['host'],
    });
    if (!room) throw new NotFoundException('Sala no encontrada');
    if (room.host.id !== dto.userId) throw new ForbiddenException('Solo el anfitrión puede iniciar');
    if (room.status !== 'waiting') throw new BadRequestException('La sala ya fue iniciada');

    room.status = 'running';
    room.startedAt = new Date();
    await this.roomsRepo.save(room);

    const bag = shuffle(range(1, 75));
    let order = 0;
    const intervalSec = Number(process.env.DRAW_INTERVAL_SEC || 5);

    const tick = async () => {
      if (bag.length === 0) {
        const t = this.timers.get(roomId);
        if (t?.timer) clearInterval(t.timer);
        this.timers.delete(roomId);
        room.status = 'ended';
        room.endedAt = new Date();
        await this.roomsRepo.save(room);
        this.gateway.broadcastRoomStatus(roomId, { status: 'ended', endedAt: room.endedAt });
        return;
      }

      const next = bag.shift()!;
      order += 1;

      await this.drawsRepo.save(this.drawsRepo.create({ room, number: next, order }));
      this.gateway.broadcastDraw(roomId, { number: next, order });

      const state = await this.getPublicState(roomId);
      this.gateway.broadcastState(roomId, state);
    };

    const timer = setInterval(tick, intervalSec * 1000);
    this.timers.set(roomId, { timer, bag, order });

    this.gateway.broadcastRoomStatus(roomId, { status: 'running', startedAt: room.startedAt });
    return { started: true };
  }

  async resumeRoom(roomId: string, dto: StartRoomDto) {
    const room = await this.roomsRepo.findOne({ where: { id: roomId }, relations: ['host'] });
    if (!room) throw new NotFoundException('Sala no encontrada');
    if (room.host.id !== dto.userId) throw new ForbiddenException('Solo el anfitrión puede reanudar');
    if (room.status === 'ended') throw new BadRequestException('La sala ya terminó');

    let info = this.timers.get(roomId);
    if (!info) {
      const drawn = await this.getDrawnNumbers(roomId);
      const remaining = this.ALL_NUMBERS.filter(n => !new Set(drawn).has(n));
      info = { timer: null, bag: shuffle(remaining), order: drawn.length };
      this.timers.set(roomId, info);
    }
    if (info.timer) return { resumed: false, reason: 'already_running' };

    const intervalSec = Number(process.env.DRAW_INTERVAL_SEC || 5);
    const tick = async () => {
      if (info!.bag.length === 0) {
        const t = this.timers.get(roomId);
        if (t?.timer) clearInterval(t.timer);
        this.timers.delete(roomId);
        room.status = 'ended';
        room.endedAt = new Date();
        await this.roomsRepo.save(room);
        this.gateway.broadcastRoomStatus(roomId, { status: 'ended', endedAt: room.endedAt });
        return;
      }

      const next = info!.bag.shift()!;
      info!.order += 1;

      await this.drawsRepo.save(this.drawsRepo.create({ room, number: next, order: info!.order }));
      this.gateway.broadcastDraw(roomId, { number: next, order: info!.order });

      const state = await this.getPublicState(roomId);
      this.gateway.broadcastState(roomId, state);
    };

    info.timer = setInterval(tick, intervalSec * 1000);
    this.timers.set(roomId, info);

    this.gateway.broadcastRoomStatus(roomId, { status: 'running' });
    return { resumed: true };
  }

  public async getPublicState(roomId: string) {
    try {
      const room = await this.roomsRepo.findOne({
        where: { id: roomId },
        relations: ['host'],
      });
      if (!room) return { id: roomId, status: 'waiting', drawn: [] as number[] };

      const [participants, purchases, claims, drawn] = await Promise.all([
        this.rpartsRepo.find({ where: { room: { id: roomId } }, relations: ['user'] }),
        this.purchasesRepo.find({ where: { room: { id: roomId } }, relations: ['user'] }),
        this.claimsRepo.find({ where: { room: { id: roomId } }, relations: ['user', 'ticket'] }),
        this.getDrawnNumbers(roomId),
      ]);

      // <-- Meta siempre presente (con defaults)
      const meta = this.buildPublicMeta(room);

      return {
        id: room.id,
        code: room.token,
        status: room.status,
        drawn,
        meta, // <<--- para calendar y montos en el front del jugador
        participants: participants.map(p => ({
          userId: p.user.id,
          name: p.user.name,
          balance: p.user.balance,
        })),
        purchases: purchases.map(pr => ({
          userId: (pr as any).user?.id,
          userName: (pr as any).user?.name,
          quantity: (pr as any).quantity,
          totalCost: (pr as any).totalCost,
        })),
        claims: claims.map(c => ({
          id: (c as any).id,
          userId: (c as any).user?.id,
          userName: (c as any).user?.name,
          ticketId: (c as any).ticket?.id,
          type: (c as any).type,
          valid: (c as any).valid,
          drawIndex: (c as any).drawIndex ?? null,
        })),
      };
    } catch {
      return { id: roomId, status: 'waiting', drawn: [] as number[] };
    }
  }

  // =================== RECLAMOS / VALIDACIÓN ===================

  async claim(roomId: string, dto: ClaimDto) {
    const [room, user, ticket, draws] = await Promise.all([
      this.roomsRepo.findOne({ where: { id: roomId } }),
      this.usersRepo.findOne({ where: { id: dto.userId } }),
      this.ticketsRepo.findOne({
        where: { id: dto.ticketId },
        relations: ['user', 'room'],
      }),
      this.drawsRepo.find({ where: { room: { id: roomId } }, order: { order: 'ASC' } }),
    ]);

    if (!room) throw new NotFoundException('Sala no encontrada');
    if (!user) throw new NotFoundException('Usuario no encontrado');
    if (!ticket || ticket.room.id !== roomId || ticket.user.id !== user.id) {
      throw new ForbiddenException('Cartón inválido');
    }

    const kind = String((dto as any).type || '').toLowerCase() as PrizeKind;
    const set = new Set(draws.map(d => d.number));
    let valid = false;
    if (kind === 'line')    valid = hasLine(ticket.grid as any, set);
    if (kind === 'bingo')   valid = hasBingo(ticket.grid as any, set);
    if (kind === 'corners') valid = hasFourCorners(ticket.grid as any, set);

    const drawIndex = draws.length;

    const existingValids = await this.claimsRepo.find({
      where: { room: { id: roomId }, type: kind as any, valid: true },
      order: { drawIndex: 'ASC' as any },
    });

    const firstIdx = existingValids.length ? Math.min(...existingValids.map(c => Number(c.drawIndex ?? 0))) : null;

    if (valid && firstIdx !== null && drawIndex > firstIdx) {
      valid = false;
    }

    const claim = this.claimsRepo.create({ room, user, ticket, type: kind as any, valid, drawIndex } as any);
    await this.claimsRepo.save(claim);

    if (valid) {
      ticket.status =
        kind === 'line'    ? 'won_line'    :
        kind === 'corners' ? 'won_corners' :
                             'won_bingo';
      await this.ticketsRepo.save(ticket);

      const becameFirst = firstIdx === null;
      if (kind === 'line') {
        if (becameFirst) {
          const info = this.timers.get(roomId);
          if (info?.timer) {
            clearInterval(info.timer);
            info.timer = null;
            this.timers.set(roomId, info);
          }
          this.gateway.broadcastRoomStatus(roomId, { status: 'running' });
        }
      } else if (kind === 'bingo') {
        if (becameFirst) {
          const info = this.timers.get(roomId);
          if (info?.timer) clearInterval(info.timer);
          this.timers.delete(roomId);
          room.status = 'ended';
          room.endedAt = new Date();
          await this.roomsRepo.save(room);
          this.gateway.broadcastRoomStatus(roomId, { status: 'ended', endedAt: room.endedAt });
        }
      }

      // Usar meta normalizado para calcular premio por cabeza
      const pubMeta = this.buildPublicMeta(room);
      const cfg = pubMeta.prizes?.[kind] ?? { amount: 0, label: kind };
      const prizeTotal = Number(cfg.amount ?? 0);

      const winIndex = firstIdx ?? drawIndex;
      const coWinners = await this.claimsRepo.find({
        where: { room: { id: roomId }, type: kind as any, valid: true, drawIndex: winIndex },
        relations: ['user', 'ticket'],
      });
      const perHead = Math.floor(prizeTotal / Math.max(1, coWinners.length));

      // >>> NOMBRE del ganador y datos de premio
      this.gateway.broadcastWin(roomId, {
        type: kind,
        userId: user.id,
        userName: user.name,           // <--- agregado
        ticketId: ticket.id,
        drawIndex,
        prizePerWinner: perHead,
        winnersCount: coWinners.length,
        prizeLabel: cfg.label ?? kind, // <--- útil para UI
        prizeTotal,                    // opcional, transparencia
      });

      this.gateway.broadcastState(roomId, await this.getPublicState(roomId));
    } else {
      this.gateway.broadcastClaim(roomId, {
        type: kind,
        userId: user.id,
        ticketId: ticket.id,
        drawIndex,
        valid: false,
      });
      this.gateway.broadcastState(roomId, await this.getPublicState(roomId));
    }

    return { valid };
  }

  // ======================= DRAWS MANUAL =======================

  async getDrawnNumbers(roomId: string): Promise<number[]> {
    const draws = await this.drawsRepo.find({
      where: { room: { id: roomId } },
      order: { order: 'ASC' },
    });
    return draws.map(d => Number(d.number));
  }

  async drawNext(roomId: string, hostId?: string): Promise<{ number: number; order: number }> {
    const room = await this.roomsRepo.findOne({
      where: { id: roomId },
      relations: ['host'],
    });
    if (!room) throw new NotFoundException('Sala no encontrada');
    if (hostId && room.host.id !== hostId) {
      throw new ForbiddenException('Solo el anfitrión puede sortear');
    }
    if (room.status !== 'running') {
      throw new BadRequestException('La sala no está en curso');
    }

    const drawn = new Set(await this.getDrawnNumbers(roomId));
    const remaining = this.ALL_NUMBERS.filter(n => !drawn.has(n));
    if (remaining.length === 0) throw new BadRequestException('No quedan números por sortear');

    const next = remaining[Math.floor(Math.random() * remaining.length)];
    const order = drawn.size + 1;

    await this.drawsRepo.save(this.drawsRepo.create({ room, number: next, order }));

    this.gateway.broadcastDraw(roomId, { number: next, order });

    const state = await this.getPublicState(roomId);
    this.gateway.broadcastState(roomId, state);

    return { number: next, order };
  }

  // ======================= UTIL =======================

  stopAllTimers() {
    for (const [roomId, t] of this.timers.entries()) {
      if (t.timer) clearInterval(t.timer);
      this.timers.delete(roomId);
    }
  }

  // ======================= HOST-ONLY: RESET / SCHEDULE =======================

  private async assertHost(roomId: string, userId: string) {
    const room = await this.roomsRepo.findOne({ where: { id: roomId }, relations: ['host'] });
    if (!room) throw new NotFoundException('Sala no encontrada');
    if (!userId || room.host.id !== userId) {
      throw new ForbiddenException('Solo el anfitrión puede realizar esta acción');
    }
    return room;
  }

  async resetRoom(roomId: string, userId: string) {
    const room = await this.assertHost(roomId, userId);

    const t = this.timers.get(roomId);
    if (t?.timer) clearInterval(t.timer);
    this.timers.delete(roomId);

    const s = this.scheduleTimers.get(roomId);
    if (s) { clearTimeout(s); this.scheduleTimers.delete(roomId); }

    await this.claimsRepo.delete({ room: { id: roomId } });
    await this.drawsRepo.delete({ room: { id: roomId } });
    await this.ticketsRepo.delete({ room: { id: roomId } });
    await this.purchasesRepo.delete({ room: { id: roomId } });

    room.status = 'waiting';
    room.startedAt = null as any;
    room.endedAt = null as any;
    room.scheduledStartAt = null;
    await this.roomsRepo.save(room);

    return { ok: true };
  }

  async scheduleRoom(roomId: string, userId: string, startAtISO: string) {
    const room = await this.assertHost(roomId, userId);

    const when = new Date(startAtISO);
    if (Number.isNaN(when.getTime())) {
      throw new BadRequestException('Fecha/hora inválida');
    }

    room.scheduledStartAt = when;
    await this.roomsRepo.save(room);
    this.gateway.broadcastRoundScheduled(roomId, when.toISOString());

    const prev = this.scheduleTimers.get(roomId);
    if (prev) clearTimeout(prev);

    const delay = Math.max(0, when.getTime() - Date.now());
    const timer = setTimeout(async () => {
      try {
        await this.resetRoom(roomId, userId);
        await this.startRoom(roomId, { userId } as any);
      } catch {
        // silenciar
      }
    }, delay);

    this.scheduleTimers.set(roomId, timer);
    return { ok: true, startAt: when.toISOString() };
  }

  async cancelSchedule(roomId: string, userId: string) {
    const room = await this.assertHost(roomId, userId);
    const s = this.scheduleTimers.get(roomId);
    if (s) { clearTimeout(s); this.scheduleTimers.delete(roomId); }
    room.scheduledStartAt = null;
    await this.roomsRepo.save(room);
    return { ok: true };
  }
}
